# Copy to .env for local use. NEVER commit a real .env -- it is gitignored.
# In production these are set in the Vercel dashboard, not in a file.

# From @BotFather when you created the bot.
TELEGRAM_BOT_TOKEN=

# Any random string you make up yourself (e.g. `openssl rand -hex 24`).
# Telegram echoes it back on every webhook call in the
# X-Telegram-Bot-Api-Secret-Token header; the webhook rejects any request
# that doesn't match, so random internet traffic can't trigger Gemini calls.
TELEGRAM_WEBHOOK_SECRET=

# The chat ID the bot will actually respond to -- Meera's private chat with
# the bot, or the private channel ID. Messages from any other chat are
# ignored. Find yours with `npm run telegram:webhook-info` after sending the
# bot one message, or by checking https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_ALLOWED_CHAT_ID=

# Google Gemini -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
